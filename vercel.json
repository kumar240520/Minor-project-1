{
  "version": 2,
  "installCommand": "npm install && cd client && npm install && cd ../server && npm install",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/server.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}